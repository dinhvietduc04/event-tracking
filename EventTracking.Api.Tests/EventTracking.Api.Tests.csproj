<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventTracking.Api\EventTracking.Api.csproj" />
    <ProjectReference Include="..\EventTracking.Worker\EventTracking.Worker.csproj" />
  </ItemGroup>

  <!-- Execute the worker's own deployment output, not the test host's shared-framework dependency set. -->
  <Target Name="PublishWorkerForProcessTests" AfterTargets="Build">
    <MSBuild Projects="../EventTracking.Worker/EventTracking.Worker.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);NoBuild=true;PublishDir=$(TargetDir)worker-process/" />
  </Target>

</Project>
